# NetScope server configuration.
# Copy to server/.env for local development. Never commit server/.env.
# Everything except DATABASE_URL is optional; the values shown are the defaults.

# development | test | production
NODE_ENV=development

# Interface the API binds to. Keep loopback until authentication exists (Step 12).
HOST=127.0.0.1
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------------------------
# Required. Defaults below match the Docker setup (compose.yaml, port 5433); use the
# POSTGRES_PASSWORD from the root .env. For a natively installed PostgreSQL use its port (5432).
# Percent-encode special characters in the password (e.g. @ -> %40, # -> %23).
# For TLS to a remote server, append ?sslmode=verify-full
DATABASE_URL=postgres://netscope:CHANGE_ME@127.0.0.1:5433/netscope

# Maximum pooled connections.
DATABASE_POOL_MAX=10
# How long to wait for a connection before failing (ms).
DATABASE_CONNECTION_TIMEOUT_MS=5000
# Server-side limit for any single SQL statement (ms).
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------------------------
# Separate database used by `npm test`. Tests delete its data, so the name must end in "_test".
TEST_DATABASE_URL=postgres://netscope:CHANGE_ME@127.0.0.1:5433/netscope_test
