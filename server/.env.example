# NetScope server configuration.
# Copy to server/.env for local development. Never commit server/.env.
# Every variable is optional; the values below are the defaults.

# development | test | production
NODE_ENV=development

# Interface the API binds to. Keep loopback until authentication exists (Step 12).
HOST=127.0.0.1
PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call the API directly.
CORS_ORIGIN=http://localhost:5173
