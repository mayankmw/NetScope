{
  "name": "@netscope/server",
  "version": "0.1.0",
  "private": true,
  "description": "NetScope API, WebSocket, and network diagnostics server.",
  "license": "MIT",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js up",
    "db:migrate:down": "node --env-file-if-exists=.env src/db/migrate.js down",
    "db:migrate:status": "node --env-file-if-exists=.env src/db/migrate.js status",
    "db:migrate:create": "node-pg-migrate create --migrations-dir src/db/migrations --migration-file-language sql --migration-filename-format utc"
  },
  "dependencies": {
    "@netscope/shared": "^0.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "oui-data": "^2.1.32",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "vitest": "^5.0.2"
  }
}
