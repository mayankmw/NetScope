# Docker Compose settings for the local PostgreSQL container (compose.yaml).
# Copy to .env in the repository root. Never commit .env.
#
# Use the same password in DATABASE_URL and TEST_DATABASE_URL in server/.env.
# Tip: `openssl rand -hex 24` generates a strong password that needs no URL-encoding.

POSTGRES_PASSWORD=CHANGE_ME

# Host port for the container. 5433 avoids clashing with a PostgreSQL installed natively on 5432.
POSTGRES_PORT=5433
