# NetScope client configuration.
# Copy to client/.env for local development. Never commit client/.env.
# Every variable is optional; the values below are the defaults.
#
# Only VITE_* variables are embedded into the browser bundle — never put secrets in them.

# Base path (or absolute URL) of the API. Keep "/api" so the browser always talks to its own
# origin: the Vite proxy in development, the same host in production.
VITE_API_BASE_URL=/api

# Dev-server only (read by vite.config.js, never shipped to the browser):
# where the Vite proxy forwards /api requests. Must match the server's HOST and PORT.
DEV_API_PROXY_TARGET=http://127.0.0.1:4000
